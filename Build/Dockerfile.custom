# ============================================================
# Stage 1: 编译 free5GC
# ============================================================
FROM golang:1.25-bookworm AS builder

WORKDIR /src

# 把整个 Free5gc-TYcustom 仓库复制进编译容器。
# 这里必须包含：
#   /src/NFs
#   /src/xnet
#   /src/config
#   /src/cert
COPY . .

# ------------------------------------------------------------
# 1. 显示编译器版本
# ------------------------------------------------------------
RUN go version

# ------------------------------------------------------------
# 2. 检查本地 xnet 是否存在，并检查其 module 名称
# ------------------------------------------------------------
RUN set -eux; \
    test -f /src/xnet/go.mod; \
    grep -q '^module golang.org/x/net$' /src/xnet/go.mod; \
    echo "Local xnet module found at /src/xnet"

# ------------------------------------------------------------
# 3. 检查七个需要使用本地 xnet 的 NF 是否配置 replace
#
# NFs/<nf>/go.mod 中必须存在：
#
# replace golang.org/x/net => ../../xnet
# ------------------------------------------------------------
RUN set -eux; \
    for nf in amf ausf nrf nssf pcf udm udr; do \
      mod="/src/NFs/$nf/go.mod"; \
      echo "Checking $mod"; \
      test -f "$mod"; \
      grep -q '^replace golang.org/x/net => ../../xnet$' "$mod"; \
    done

# ------------------------------------------------------------
# 4. 对七个 NF 运行 go mod tidy
#
# 作用：
#   - 重新读取本地 /src/xnet/go.mod
#   - 补齐缺少的依赖和 go.sum
#   - 检查 module dependency graph
#
# 注意：
# 这里修改的是 Docker builder 内部 COPY 出来的 go.mod/go.sum，
# 不会修改宿主机上的源代码文件。
# ------------------------------------------------------------
RUN set -eux; \
    for nf in amf ausf nrf nssf pcf udm udr; do \
      echo "================================================"; \
      echo "Running go mod tidy for $nf"; \
      echo "================================================"; \
      cd "/src/NFs/$nf"; \
      go mod tidy; \
    done

# ------------------------------------------------------------
# 5. 检查 Go module 最终是否真的解析到 /src/xnet
#
# 正确输出示例：
#   amf: golang.org/x/net => /src/xnet
# ------------------------------------------------------------
RUN set -eux; \
    for nf in amf ausf nrf nssf pcf udm udr; do \
      cd "/src/NFs/$nf"; \
      resolved="$(go list -m -f '{{with .Replace}}{{.Dir}}{{end}}' golang.org/x/net)"; \
      echo "$nf: golang.org/x/net => $resolved"; \
      test "$resolved" = "/src/xnet"; \
    done

# ------------------------------------------------------------
# 6. 重新生成 AMF NGAP dispatcher/handler
# ------------------------------------------------------------
RUN set -eux; \
    cd /src/NFs/amf/internal/ngap; \
    go run ngap_generator.go

# ------------------------------------------------------------
# 7. 编译全部 NF
#
# CGO_ENABLED=0:
#   生成静态 Go 二进制，便于放进 Alpine runtime image。
#
# go build .:
#   编译整个 cmd package，而不只是单独编译 main.go。
# ------------------------------------------------------------
RUN set -eux; \
    mkdir -p /out; \
    for nf in amf ausf bsf nrf nssf pcf smf udm udr chf nef n3iwf tngf; do \
      echo "================================================"; \
      echo "Building $nf"; \
      echo "================================================"; \
      cd "/src/NFs/$nf/cmd"; \
      CGO_ENABLED=0 go build \
        -trimpath \
        -o "/out/$nf" \
        .; \
      test -x "/out/$nf"; \
    done

# ------------------------------------------------------------
# 8. 验证七个 NF 的最终二进制中记录了本地 xnet replace
#
# 仅仅检查 go list 还不够，这一步直接读取最终二进制中的
# Go BuildInfo。
# ------------------------------------------------------------
RUN set -eux; \
    for nf in amf ausf nrf nssf pcf udm udr; do \
      echo "================================================"; \
      echo "Checking xnet BuildInfo in $nf"; \
      echo "================================================"; \
      info="$(go version -m "/out/$nf")"; \
      printf '%s\n' "$info" | grep -A1 'golang.org/x/net'; \
      printf '%s\n' "$info" \
        | grep -A1 'golang.org/x/net' \
        | grep -Eq '(/src/xnet|\.\./\.\./xnet)'; \
    done

# ------------------------------------------------------------
# 9. 显示所有编译结果
# ------------------------------------------------------------
RUN set -eux; \
    ls -lh /out; \
    for nf in amf ausf bsf nrf nssf pcf smf udm udr chf nef n3iwf tngf; do \
      test -s "/out/$nf"; \
    done


# ============================================================
# Stage 2: free5GC 运行镜像
# ============================================================
FROM alpine:3.19 AS runtime

WORKDIR /free5gc

# bash:
#   保持与你当前的启动方式兼容。
#
# iproute2 / iptables:
#   提供 free5GC 运行和网络排查可能使用的命令。
#
# libc6-compat:
#   保持与你原来镜像的兼容性。虽然本次使用 CGO_ENABLED=0，
#   静态 Go 二进制通常不依赖 glibc。
#
# ca-certificates:
#   提供 CA 证书。
RUN apk add --no-cache \
    bash \
    iproute2 \
    iptables \
    libc6-compat \
    ca-certificates

# 只复制最终二进制。
#
# 不需要把 /src/xnet 复制到 runtime image，
# 因为 xnet 已经在编译阶段链接进 NF 二进制。
COPY --from=builder /out/ /free5gc/

# 确认 runtime image 内所有二进制存在
RUN set -eux; \
    for nf in amf ausf bsf nrf nssf pcf smf udm udr chf nef n3iwf tngf; do \
      test -x "/free5gc/$nf"; \
    done; \
    ls -lh /free5gc

CMD ["bash"]
